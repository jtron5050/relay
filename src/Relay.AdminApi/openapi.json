{
  "openapi": "3.1.0",
  "info": {
    "title": "Relay Admin API",
    "version": "v1",
    "description": "Implemented surface only. Future /v1 routes are specified in docs/api-v1.md."
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "healthy"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/openapi/v1.json": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Implemented OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "staffBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cognito staff access token. Each protected operation requires its named Relay permission."
      }
    }
  },
  "x-relay-conventions": {
    "requestBytes": 262144,
    "pageDefault": 50,
    "pageMaximum": 100,
    "cursorMaximumCharacters": 4096,
    "cursorLifetimeSeconds": 900,
    "correlationHeader": "X-Correlation-Id",
    "retryAfterSeconds": 5,
    "revisionHeader": "If-Match: \"rev-7\"",
    "idempotencyHeader": "Idempotency-Key"
  }
}
