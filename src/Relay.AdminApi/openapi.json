{
  "openapi": "3.1.0",
  "info": {
    "title": "Relay Admin API",
    "version": "v1",
    "description": "Implemented surface only. Future /v1 routes are specified in docs/api-v1.md."
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "healthy"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/openapi/v1.json": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Implemented OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit-events": {
      "get": {
        "summary": "List administrative audit history",
        "description": "Shard-major traversal. Target-filtered results are eventually consistent. Empty pages may have a continuation.",
        "security": [
          {
            "staffBearer": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "UTC, inclusive from and exclusive to; maximum 31 days."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "UTC, inclusive from and exclusive to; maximum 31 days."
          },
          {
            "name": "targetType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Supply both targetType and targetId."
          },
          {
            "name": "targetId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Supply both targetType and targetId."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Page size."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque continuation, maximum 4096 characters."
          }
        ],
        "responses": {
          "200": {
            "description": "Audit page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuditEvent"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "audit.read required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "410": {
            "description": "Cursor expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlationId",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "required": [
          "id",
          "actorKind",
          "actorId",
          "action",
          "targetType",
          "targetId",
          "occurredAt",
          "correlationId",
          "beforeRevision",
          "afterRevision",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actorKind": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string"
          },
          "beforeRevision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "afterRevision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "staffBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cognito staff access token. Each protected operation requires its named Relay permission."
      }
    }
  },
  "x-relay-conventions": {
    "requestBytes": 262144,
    "pageDefault": 50,
    "pageMaximum": 100,
    "cursorMaximumCharacters": 4096,
    "cursorLifetimeSeconds": 900,
    "correlationHeader": "X-Correlation-Id",
    "retryAfterSeconds": 5,
    "revisionHeader": "If-Match: \"rev-7\"",
    "idempotencyHeader": "Idempotency-Key"
  }
}
