<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Relay.Core/Relay.Core.csproj" />
    <ProjectReference Include="../Relay.Infrastructure/Relay.Infrastructure.csproj" />
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../SharedApi/*.cs" Link="Http/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
